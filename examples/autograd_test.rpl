impor "matematika.rpl"

tampilkan("--- Uji Coba AutoGrad (Forward-Mode AD) ---")

// Fungsi 1: f(x) = x^2
// f'(x) = 2x
buat f1 = x => x^2
buat grad1 = Matematika.turunan(f1, 5) // f'(5) = 2(5) = 10
tampilkan("Turunan x^2 pada x=5 adalah: " + grad1)

// Fungsi 2: f(x) = x^3 + 2x^2 + x
// f'(x) = 3x^2 + 4x + 1
buat f2 = x => x^3 + 2 * (x^2) + x
buat grad2 = Matematika.turunan(f2, 2) // f'(2) = 3(4) + 4(2) + 1 = 12 + 8 + 1 = 21
tampilkan("Turunan x^3 + 2x^2 + x pada x=2 adalah: " + grad2)

// Fungsi 3: f(x) = sin(x)
// f'(x) = cos(x)
buat f3 = x => Matematika.sin(x)
buat grad3 = Matematika.turunan(f3, Matematika.PI) // cos(PI) = -1
tampilkan("Turunan sin(x) pada x=PI adalah: " + grad3)

// Fungsi 4: f(x) = exp(x^2)
// f'(x) = 2x * exp(x^2)
buat f4 = x => Matematika.exp(x^2)
buat grad4 = Matematika.turunan(f4, 1) // 2(1) * exp(1) = 2 * E = 5.43656
tampilkan("Turunan exp(x^2) pada x=1 adalah: " + grad4)
tampilkan("Nilai ekspektasi (2*E): " + (2 * Matematika.E))
