tampilkan("Mulai tes file")

// Membuat folder
buat hasil_buat = file.buat_folder("folder_tes_rpl")
tampilkan("Berhasil buat folder? " + hasil_buat)

// Mendaftar file (tanpa hidden file)
buat daftar_file = file.daftar(".")
tampilkan("Daftar file:")
tampilkan(daftar_file)

// Mendaftar file (dengan hidden file)
buat daftar_file_hidden = file.daftar(".", benar)
tampilkan("Daftar file (dengan hidden):")
tampilkan(daftar_file_hidden)

// Membersihkan
// file.hapus("folder_tes_rpl") hanya untuk file, untuk direktori harus menggunakan std::fs::remove_dir.
// Karena file.hapus diimplementasikan menggunakan remove_file, mungkin akan gagal untuk folder.
tampilkan("Selesai")
