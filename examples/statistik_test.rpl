// Uji fungsi random (Mersenne Twister)
buat rng = Statistik.buatGenerator(42)
tampilkan("Angka acak 1 (seed 42): " + Statistik.angkaAcak(rng))
tampilkan("Angka acak 2 (seed 42): " + Statistik.angkaAcak(rng))

// Buat tensor/array untuk diuji
buat data = [1.0, 5.0, 7.0, 3.0, 5.0, 10.0, 2.0, 9.0]
tampilkan("Data:")
tampilkan(data)

// Tes fungsi statistik
tampilkan("Mean (Rata-rata): " + Statistik.mean(data))
tampilkan("Median: " + Statistik.median(data))
tampilkan("Variance (Sampel): " + Statistik.variance(data))
tampilkan("Standard Deviation: " + Statistik.std(data))
tampilkan("Min: " + Statistik.min(data))
tampilkan("Max: " + Statistik.max(data))
tampilkan("Sum: " + Statistik.sum(data))
tampilkan("Argmax (Indeks nilai terbesar): " + Statistik.argmax(data))

tampilkan("Semua uji coba berhasil!")
